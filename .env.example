OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- LangSmith tracing (optional) ---
# Leave LANGSMITH_TRACING unset/false to disable tracing entirely (the pipeline
# runs unchanged with no LangSmith calls). Set to true and provide a key to trace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=eu-ai-act-rag
# US data region (default). For the EU region use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
